{
    "title": "Module Fields",
    "model": "App\\Models\\ModuleField",
    "perPage": 15,
    "defaultSort": {
        "column": "sort_order",
        "direction": "asc"
    },
    "columns": [
        {
            "type": "text",
            "name": "module.plural_label",
            "label": "Module",
            "searchable": {
                "global": true,
                "individual": true
            },
            "sortable": true,
            "wrap": false
        },
        {
            "type": "text",
            "name": "field_name",
            "label": "Field Name",
            "description": "label",
            "searchable": {
                "global": true,
                "individual": true
            },
            "sortable": true,
            "wrap": false
        },
        {
            "type": "badge",
            "name": "type",
            "label": "Type",
            "dropdown": "field_type_dom",
            "color_map": {
                "text": "gray",
                "textarea": "gray",
                "number": "info",
                "email": "info",
                "url": "info",
                "phone": "info",
                "select": "warning",
                "dropdown": "warning",
                "toggle": "success",
                "checkbox": "success",
                "radio": "warning",
                "checkbox_list": "warning",
                "date": "primary",
                "time": "primary",
                "datetime": "primary",
                "file": "danger",
                "image": "danger",
                "currency": "info",
                "color": "warning",
                "tags": "gray",
                "relationship": "primary",
                "relate": "primary",
                "address": "gray",
                "json": "danger"
            },
            "sortable": true
        },
        {
            "type": "text",
            "name": "sort_order",
            "label": "Order",
            "sortable": true,
            "default": "—"
        },
        {
            "type": "icon",
            "name": "required",
            "label": "Required",
            "boolean": true
        },
        {
            "type": "icon",
            "name": "searchable",
            "label": "Searchable",
            "boolean": true
        },
        {
            "type": "icon",
            "name": "sortable",
            "label": "Sortable",
            "boolean": true
        },
        {
            "type": "icon",
            "name": "unique_field",
            "label": "Unique",
            "boolean": true
        },
        {
            "type": "text",
            "name": "createdBy.name",
            "label": "Created By",
            "sortable": false,
            "default": "—",
            "toggleable": true,
            "toggledHiddenByDefault": true
        },
        {
            "type": "text",
            "name": "created_at",
            "label": "Created At",
            "date": true,
            "format": "d M Y, h:i A",
            "sortable": true,
            "default": "—",
            "toggleable": true,
            "toggledHiddenByDefault": true
        },
        {
            "type": "text",
            "name": "updatedBy.name",
            "label": "Updated By",
            "sortable": false,
            "default": "—",
            "toggleable": true,
            "toggledHiddenByDefault": true
        },
        {
            "type": "text",
            "name": "updated_at",
            "label": "Updated At",
            "date": true,
            "format": "d M Y, h:i A",
            "sortable": true,
            "default": "—",
            "toggleable": true,
            "toggledHiddenByDefault": true
        }
    ],
    "filters": [
        {
            "type": "select",
            "name": "module_id",
            "label": "Module",
            "options_source": "relationship",
            "relationship": "module",
            "title_column": "plural_label"
        },
        {
            "type": "select",
            "name": "type",
            "label": "Field Type",
            "options_source": "helper",
            "helper_class": "App\\Helpers\\Studio\\DropdownHandler",
            "helper_method": "getStudioDom",
            "helper_params": ["field_type_dom"]
        },
        {
            "type": "select",
            "name": "required",
            "label": "Required",
            "options": {
                "1": "Required",
                "0": "Optional"
            }
        }
    ],
    "filters_layout": "modal",
    "record_action": null,
    "record_url": null,
    "actions": [
        {
            "type": "view",
            "label": "Details",
            "ui": {
                "hiddenLabel": true,
                "iconButton": true,
                "tooltip": "View Details",
                "icon": "heroicon-o-eye"
            }
        },
        {
            "type": "edit",
            "label": "Edit",
            "ui": {
                "icon": "heroicon-m-pencil-square",
                "slideOver": true,
                "hiddenLabel": true,
                "iconButton": true,
                "tooltip": "Edit Field",
                "modalHeading": "Update Field",
                "modalWidth": "SevenExtraLarge"
            }
        },
        {
            "type": "popup",
            "name": "dom_editor",
            "label": "Edit Options",
            "fill_hook": "App\\Filament\\Resources\\ModuleFields\\Hooks\\ModuleFieldDomHooks@fillDomForm",
            "hooks": {
                "action": "App\\Filament\\Resources\\ModuleFields\\Hooks\\ModuleFieldDomHooks@saveDomOptions"
            },
            "schema": {
                "components": [
                    {
                        "component": "repeater",
                        "name": "options",
                        "label": "Dropdown Options",
                        "addActionLabel": "Add Option",
                        "columns": 3,
                        "reorderable": true,
                        "schema": [
                            {
                                "component": "checkbox",
                                "name": "default",
                                "label": "Default",
                                "columnSpan": 1
                            },
                            {
                                "component": "textInput",
                                "name": "key",
                                "label": "Value",
                                "columnSpan": 1,
                                "required": true
                            },
                            {
                                "component": "textInput",
                                "name": "value",
                                "label": "Display Label",
                                "columnSpan": 1,
                                "required": true
                            }
                        ]
                    }
                ]
            },
            "visible_when": {
                "field": "type",
                "operator": "in",
                "value": ["select", "radio", "checkbox_list", "checkboxlist"]
            },
            "ui": {
                "hiddenLabel": true,
                "iconButton": true,
                "tooltip": "Edit Dropdown Options",
                "icon": "heroicon-o-list-bullet",
                "color": "warning",
                "modalHeading": "Edit Dropdown Options",
                "modalWidth": "ExtraLarge"
            }
        },
        {
            "type": "delete",
            "label": "Delete",
            "ui": {
                "hiddenLabel": true,
                "iconButton": true,
                "tooltip": "Delete Field",
                "icon": "heroicon-o-trash",
                "color": "danger"
            }
        }
    ],
    "record_actions_position": "BeforeColumns",
    "bulkActions": []
} 
