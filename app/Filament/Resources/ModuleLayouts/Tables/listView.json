{
    "title": "Module Layouts",
    "model": "App\\Models\\ModuleLayout",
    "perPage": 15,
    "defaultSort": {
        "column": "module_id",
        "direction": "asc"
    },
    "columns": [
        {
            "type": "text",
            "name": "module.fullnamelabel",
            "label": "Module",
            "searchable": {
                "global": true,
                "individual": true
            },
            "sortable": true,
            "wrap": false
        },
        {
            "type": "badge",
            "name": "layout_type",
            "label": "View Type",
            "dropdown": "layout_type_dom",
            "color_map": {
                "create": "success",
                "edit": "warning",
                "detail": "info",
                "list": "primary"
            },
            "sortable": true,
            "searchable": {
                "global": true,
                "individual": false
            }
        },
        {
            "type": "text",
            "name": "layout_json",
            "label": "Sections & Fields",
            "format_hook": "App\\Helpers\\Studio\\LayoutPreviewHelper@formatLayoutSummary",
            "sortable": false
        },
        {
            "type": "icon",
            "name": "inherit_edit_layout",
            "label": "Copies to Edit",
            "boolean": true,
            "tooltip": "Layout is copied to the Edit View on save"
        },
        {
            "type": "icon",
            "name": "inherit_detail_layout",
            "label": "Copies to Detail",
            "boolean": true,
            "tooltip": "Layout is copied to the Detail View on save"
        },
        {
            "type": "text",
            "name": "updated_at",
            "label": "Last Updated",
            "date": true,
            "format": "d M Y, h:i A",
            "sortable": true
        },
        {
            "type": "text",
            "name": "createdBy.name",
            "label": "Created By",
            "sortable": false,
            "default": "—",
            "toggleable": true,
            "toggledHiddenByDefault": true
        },
        {
            "type": "text",
            "name": "created_at",
            "label": "Created At",
            "date": true,
            "format": "d M Y, h:i A",
            "sortable": true,
            "default": "—",
            "toggleable": true,
            "toggledHiddenByDefault": true
        },
        {
            "type": "text",
            "name": "updatedBy.name",
            "label": "Updated By",
            "sortable": false,
            "default": "—",
            "toggleable": true,
            "toggledHiddenByDefault": true
        }
    ],
    "filters": [
        {
            "type": "select",
            "name": "layout_type",
            "label": "View Type",
            "options_source": "helper",
            "helper_class": "App\\Helpers\\Studio\\DropdownHandler",
            "helper_method": "get",
            "helper_params": ["layout_type_dom"]
        },
        {
            "type": "select",
            "name": "module_id",
            "label": "Module",
            "options_source": "relationship",
            "relationship": "module",
            "title_column": "plural_label"
        }
    ],
    "filters_layout": "modal",
    "record_action": null,
    "record_url": null,
    "actions": [
        {
            "type": "view",
            "label": "Details",
            "ui": {
                "hiddenLabel": true,
                "iconButton": true,
                "tooltip": "View Details",
                "icon": "heroicon-o-eye"
            }
        },
        {
            "type": "edit",
            "label": "Edit",
            "ui": {
                "icon": "heroicon-m-pencil-square",
                "slideOver": true,
                "hiddenLabel": true,
                "iconButton": true,
                "tooltip": "Edit Layout",
                "modalHeading": "Update Layout",
                "modalWidth": "SevenExtraLarge"
            }
        },
        {
            "type": "delete",
            "label": "Delete",
            "ui": {
                "hiddenLabel": true,
                "iconButton": true,
                "tooltip": "Delete Layout",
                "icon": "heroicon-o-trash",
                "color": "danger"
            }
        }
    ],
    "record_actions_position": "BeforeColumns",
    "bulkActions": []
}
