{
    "form_name": "module_edit_form",
    "model": "App\\Models\\Module",
    "components": [
        {
            "component": "section",
            "label": "Module Identity",
            "description": "Update display labels and navigation icon. The module name cannot be changed once the module is deployed.",
            "icon": "heroicon-o-cube",
            "columnSpan": "full",
            "collapsible": false,
            "compact": true,
            "columns": 2,
            "schema": [
                {
                    "component": "textInput",
                    "name": "key",
                    "label": "Key",
                    "columnSpan": 1,
                    "validate_on_blur": true,
                    "validation": [
                        "max:4",
                        "string",
                        "regex:/^[a-zA-Z]*$/"
                    ],
                    "disabled_when": {
                        "field": "is_deploy",
                        "value": true
                    },
                    "strict_messages": true,
                    "messages": {
                        "max": "Key must not exceed 4 characters.",
                        "regex": "Key can contain only letters. Example: crm, Api, SSI."
                    }
                },
                {
                    "component": "textInput",
                    "name": "name",
                    "label": "Module Name",
                    "columnSpan": 1,
                    "options_source": "helper",
                    "helper_type": "dynamic",
                    "helper_class": "App\\Helpers\\CommonHelper",
                    "helper_method": "populatemodulelabes",
                    "unique": true,
                    "helper_params": [
                        "name"
                    ],
                    "reactive": true,
                    "required": true,
                    "populate_fields": [
                        "singular_label",
                        "plural_label"
                    ],
                    "disabled_when": {
                        "field": "is_deploy",
                        "value": true
                    },
                    "validate_on_blur": true,
                    "validation": [
                        "max:50",
                        "regex:/^[A-Za-z][A-Za-z0-9_]*$/"
                    ],
                    "strict_messages": true,
                    "messages": {
                        "max": "Module name must not exceed 50 characters.",
                        "regex": "Module name must start with a letter and can contain only letters, numbers, and underscores. Example: CustomerOrder or customer_order."
                    }
                },
                {
                    "component": "select",
                    "name": "icon",
                    "label": "Navigation Icon",
                    "options_source": "helper",
                    "helper_class": "App\\Helpers\\Studio\\DropdownHandler",
                    "helper_method": "get",
                    "helper_params": [
                        "moudle_icons_dom"
                    ],
                    "columnSpan": 1,
                    "required": false
                },
                {
                    "component": "textInput",
                    "name": "singular_label",
                    "label": "Singular Label",
                    "columnSpan": 1,
                    "required": true
                },
                {
                    "component": "textInput",
                    "name": "plural_label",
                    "label": "Plural Label",
                    "columnSpan": 1,
                    "required": true
                },
                {
                    "component": "textarea",
                    "name": "description",
                    "label": "Description",
                    "columnSpan": 2,
                    "rows": 3,
                    "required": false
                },
                {
                    "component": "toggle",
                    "name": "use_uuid",
                    "label": "Use UUID in URLs",
                    "hintIcon": "When ON — record URLs show a UUID instead of the numeric ID. Takes effect on next Deploy or Repair & Rebuild.",
                    "columnSpan": 1
                }
            ]
        }
    ]
}
