{
    "form_name": "module_edit_form",
    "model": "App\\Models\\Module",
    "components": [
        {
            "component": "section",
            "label": "Module Identity",
            "description": "Update display labels and navigation icon. The module name cannot be changed once the module is deployed.",
            "icon": "heroicon-o-cube",
            "columnSpan": "full",
            "collapsible": false,
            "compact": true,
            "columns": 2,
            "schema": [
                {
                    "component": "textInput",
                    "name": "name",
                    "label": "Module Name",
                    "columnSpan": 1,
                    "options_source": "helper",
                    "helper_type": "dynamic",
                    "helper_class": "App\\Helpers\\CommonHelper",
                    "helper_method": "populatemodulelabes",
                    "unique": true,
                    "helper_params": [
                        "name"
                    ],
                    "reactive": true,
                    "required": true,
                    "populate_fields": [
                        "singular_label",
                        "plural_label"
                    ],
                    "disabled_when": {
                        "field": "is_deploy",
                        "value": true
                    },
                    "validation": [
                        "max:50",
                        "regex:/^[a-z][a-z0-9_]*$/"
                    ]
                },
                {
                    "component": "select",
                    "name": "icon",
                    "label": "Navigation Icon",
                    "options_source": "helper",
                    "helper_class": "App\\Helpers\\Studio\\DropdownHandler",
                    "helper_method": "get",
                    "helper_params": [
                        "moudle_icons_dom"
                    ],
                    "columnSpan": 1,
                    "required": false
                },
                {
                    "component": "textInput",
                    "name": "singular_label",
                    "label": "Singular Label",
                    "columnSpan": 1,
                    "required": true
                },
                {
                    "component": "textInput",
                    "name": "plural_label",
                    "label": "Plural Label",
                    "columnSpan": 1,
                    "required": true
                },
                {
                    "component": "textarea",
                    "name": "description",
                    "label": "Description",
                    "columnSpan": 2,
                    "rows": 3,
                    "required": false
                },
                {
                    "component": "toggle",
                    "name": "use_uuid",
                    "label": "Use UUID in URLs",
                    "hint": "When ON — record URLs show a UUID instead of the numeric ID. Takes effect on next Deploy or Repair & Rebuild.",
                    "columnSpan": 2
                }
            ]
        },
        {
            "component": "section",
            "label": "List Filters",
            "description": "Choose which fields appear as filters in the list view table. Repair & Rebuild the module after saving.",
            "icon": "heroicon-o-funnel",
            "columnSpan": "full",
            "collapsible": true,
            "compact": false,
            "columns": 1,
            "schema": [
                {
                    "component": "repeater",
                    "name": "filters_json",
                    "label": null,
                    "columnSpan": 1,
                    "columns": 3,
                    "schema": [
                        {
                            "component": "select",
                            "name": "field_name",
                            "label": "Field",
                            "columnSpan": 1,
                            "options_source": "helper",
                            "helper_type": "dynamic",
                            "helper_class": "App\\Helpers\\CommonHelper",
                            "helper_method": "getModuleFieldsByName",
                            "helper_params": ["../../name"],
                            "required": true,
                            "searchable": true
                        },
                        {
                            "component": "select",
                            "name": "filter_type",
                            "label": "Filter Type",
                            "columnSpan": 1,
                            "options_source": "helper",
                            "helper_class": "App\\Helpers\\Studio\\DropdownHandler",
                            "helper_method": "get",
                            "helper_params": ["filter_type_dom"],
                            "required": true
                        },
                        {
                            "component": "textInput",
                            "name": "label",
                            "label": "Filter Label",
                            "columnSpan": 1,
                            "placeholder": "Leave blank to use field label",
                            "required": false
                        }
                    ]
                }
            ]
        },
        {
            "component": "section",
            "label": "Module Relationships",
            "description": "Define Eloquent relationships this module has with other modules. These are used when generating model code.",
            "icon": "heroicon-o-arrow-path-rounded-square",
            "columnSpan": "full",
            "collapsible": true,
            "compact": false,
            "visible_when": {
                "field": "is_relationships",
                "value": true
            },
            "columns": 1,
            "schema": [
                {
                    "component": "repeater",
                    "name": "relationships_json",
                    "label": null,
                    "columnSpan": 1,
                    "columns": 4,
                    "schema": [
                        {
                            "component": "select",
                            "name": "type",
                            "label": "Relationship Type",
                            "columnSpan": 1,
                            "options_source": "helper",
                            "helper_class": "App\\Helpers\\Studio\\DropdownHandler",
                            "helper_method": "get",
                            "helper_params": [
                                "relationship_type_dom"
                            ],
                            "required": true,
                            "searchable": false,
                            "live": true
                        },
                        {
                            "component": "select",
                            "name": "related_module",
                            "label": "Related Module",
                            "columnSpan": 1,
                            "options_source": "helper",
                            "helper_type": "dynamic",
                            "helper_class": "App\\Helpers\\CommonHelper",
                            "helper_method": "getModulesOptionsExcluding",
                            "helper_params": ["../../name"],
                            "required": true,
                            "searchable": true,
                            "live": true
                        },
                        {
                            "component": "textInput",
                            "name": "name",
                            "label": "Method Name",
                            "placeholder": "e.g. orders",
                            "columnSpan": 1,
                            "required": false,
                            "validation": [
                                "regex:/^[a-zA-Z_][a-zA-Z0-9_]*$/"
                            ]
                        },
                        {
                            "component": "select",
                            "name": "foreign_key",
                            "label": "Foreign Key",
                            "columnSpan": 1,
                            "options_source": "helper",
                            "helper_type": "dynamic",
                            "helper_class": "App\\Helpers\\CommonHelper",
                            "helper_method": "getForeignKeyOptions",
                            "helper_params": ["related_module", "type", "../../name"],
                            "required": false,
                            "searchable": true,
                            "placeholder": "Auto (use Laravel default)"
                        }
                    ]
                }
            ]
        }
    ]
}
