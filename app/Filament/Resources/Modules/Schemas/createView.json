{
    "form_name": "module_create_form",
    "model": "App\\Models\\Module",
    "components": [
        {
            "component": "section",
            "label": "Module Identity",
            "description": "Define the module name and display labels. The name is used as the database table key — lowercase letters, numbers, and underscores only.",
            "icon": "heroicon-o-cube",
            "columnSpan": "full",
            "collapsible": false,
            "compact": true,
            "columns": 2,
            "schema": [
                {
                    "component": "textInput",
                    "name": "key",
                    "label": "Key",
                    "columnSpan": 1,
                    "required": true,
                    "validate_on_blur": true,
                    "validation": [
                        "required",
                        "regex:/^[a-zA-Z]+$/",
                        "max:4"
                    ],
                    "strict_messages": true,
                    "messages": {
                        "required": "Key is required.",
                        "regex": "Key must contain letters only — no spaces, numbers, or symbols. Example: crm, ssi.",
                        "max": "Key must not exceed 4 characters."
                    },
                    "after_state_updated": "\\App\\Filament\\Resources\\Modules\\Hooks\\ModuleHooks@revalidateNameOnKeyChange"
                },
                {
                    "component": "textInput",
                    "name": "name",
                    "label": "Module Name",
                    "columnSpan": 1,
                    "options_source": "helper",
                    "helper_type": "dynamic",
                    "helper_class": "App\\Helpers\\CommonHelper",
                    "helper_method": "populatemodulelabes",
                    "populate_mode": "create",
                    "helper_params": [
                        "name"
                    ],
                    "reactive": true,
                    "required": true,
                    "populate_fields": [
                        "singular_label",
                        "plural_label"
                    ],
                    "validate_on_blur": true,
                    "validation": [
                        "max:50",
                        "regex:/^[A-Za-z][A-Za-z0-9_]*$/"
                    ],
                    "strict_messages": true,
                    "messages": {
                        "max": "Module name must not exceed 50 characters.",
                        "regex": "Module name must start with a letter and contain only letters, numbers, and underscores — no spaces allowed. Example: CustomerOrder or customer_order."
                    },
                    "custom_rule":  "\\App\\Filament\\Resources\\Modules\\Hooks\\ModuleHooks@ValidateModuleName" 
                },
                {
                    "component": "select",
                    "name": "icon",
                    "label": "Navigation Icon",
                    "options_source": "helper",
                    "helper_class": "App\\Helpers\\Studio\\DropdownHandler",
                    "helper_method": "get",
                    "helper_params": [
                        "moudle_icons_dom"
                    ],
                    "columnSpan": 1,
                    "required": false
                },
                {
                    "component": "textInput",
                    "name": "singular_label",
                    "label": "Singular Label",
                    "columnSpan": 1,
                    "required": true
                },
                {
                    "component": "textInput",
                    "name": "plural_label",
                    "label": "Plural Label",
                    "columnSpan": 1,
                    "required": true
                },
                {
                    "component": "textarea",
                    "name": "description",
                    "label": "Description",
                    "columnSpan": 2,
                    "rows": 3,
                    "required": false
                },
                {
                    "component": "toggle",
                    "name": "use_uuid",
                    "label": "Use UUID in URLs",
                    "hintIcon": "When ON — record URLs show a UUID instead of the numeric ID (e.g. /leads/550e8400… instead of /leads/1)",
                    "columnSpan": 1
                }
            ]
        }
    ]
}