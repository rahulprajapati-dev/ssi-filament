{
    "form_name": "module_create_form",
    "model": "App\\Models\\Module",
    "components": [
        {
            "component": "section",
            "label": "Module Identity",
            "description": "Define the module name and display labels. The name is used as the database table key — lowercase letters, numbers, and underscores only.",
            "icon": "heroicon-o-cube",
            "columnSpan": "full",
            "collapsible": false,
            "compact": true,
            "columns": 2,
            "schema": [
                {
                    "component": "textInput",
                    "name": "key",
                    "label": "Key",
                    "columnSpan": 1,
                    "validate_on_blur": true,
                    "validation": [
                        "max:4",
                        "string",
                        "regex:/^[a-zA-Z]*$/"
                    ],
                    "strict_messages": true,
                    "messages": {
                        "max": "Key must not exceed 4 characters.",
                        "regex": "Key can contain only letters. Example: crm, Api, SSI."
                    }
                },
                {
                    "component": "textInput",
                    "name": "name",
                    "label": "Module Name",
                    "columnSpan": 1,
                    "options_source": "helper",
                    "helper_type": "dynamic",
                    "helper_class": "App\\Helpers\\CommonHelper",
                    "helper_method": "populatemodulelabes",
                    "populate_mode": "create",
                    "unique": true,
                    "helper_params": [
                        "name"
                    ],
                    "reactive": true,
                    "required": true,
                    "populate_fields": [
                        "singular_label",
                        "plural_label"
                    ],
                    "validate_on_blur": true,
                    "validation": [
                        "max:50",
                        "regex:/^[A-Za-z][A-Za-z0-9_]*$/"
                    ],
                    "strict_messages": true,
                    "messages": {
                        "max": "Module name must not exceed 50 characters.",
                        "regex": "Module name must start with a letter and can contain only letters, numbers, and underscores. Example: CustomerOrder or customer_order."
                    }
                },
                {
                    "component": "select",
                    "name": "icon",
                    "label": "Navigation Icon",
                    "options_source": "helper",
                    "helper_class": "App\\Helpers\\Studio\\DropdownHandler",
                    "helper_method": "get",
                    "helper_params": [
                        "moudle_icons_dom"
                    ],
                    "columnSpan": 1,
                    "required": false
                },
                {
                    "component": "textInput",
                    "name": "singular_label",
                    "label": "Singular Label",
                    "columnSpan": 1,
                    "required": true
                },
                {
                    "component": "textInput",
                    "name": "plural_label",
                    "label": "Plural Label",
                    "columnSpan": 1,
                    "required": true
                },
                {
                    "component": "textarea",
                    "name": "description",
                    "label": "Description",
                    "columnSpan": 2,
                    "rows": 3,
                    "required": false
                },
                {
                    "component": "toggle",
                    "name": "use_uuid",
                    "label": "Use UUID in URLs",
                    "hintIcon": "When ON — record URLs show a UUID instead of the numeric ID (e.g. /leads/550e8400… instead of /leads/1)",
                    "columnSpan": 1
                },
                {
                    "component": "toggle",
                    "name": "is_relationships",
                    "label": "Add Relationship",
                    "columnSpan": 1,
                    "reactive": true
                }
            ]
        },
        {
            "component": "section",
            "label": "Module Relationships",
            "description": "Optionally define Eloquent relationships to other modules upfront. You can also add these later via the Edit form.",
            "icon": "heroicon-o-arrow-path-rounded-square",
            "columnSpan": "full",
            "collapsible": true,
            "compact": false,
            "columns": 1,
            "visible_when": {
                "field": "is_relationships",
                "value": true
            },
            "schema": [
                {
                    "component": "repeater",
                    "name": "relationships_json",
                    "label": null,
                    "columnSpan": 1,
                    "columns": 4,
                    "schema": [
                        {
                            "component": "select",
                            "name": "type",
                            "label": "Relationship Type",
                            "columnSpan": 1,
                            "options_source": "helper",
                            "helper_class": "App\\Helpers\\Studio\\DropdownHandler",
                            "helper_method": "get",
                            "helper_params": [
                                "relationship_type_dom"
                            ],
                            "required": true,
                            "searchable": false,
                            "live": true
                        },
                        {
                            "component": "select",
                            "name": "related_module",
                            "label": "Related Module",
                            "columnSpan": 1,
                            "options_source": "helper",
                            "helper_type": "dynamic",
                            "helper_class": "App\\Helpers\\CommonHelper",
                            "helper_method": "getModulesOptionsExcluding",
                            "helper_params": [
                                "../../name"
                            ],
                            "required": true,
                            "searchable": true,
                            "live": true
                        },
                        {
                            "component": "textInput",
                            "name": "name",
                            "label": "Method Name",
                            "placeholder": "e.g. orders",
                            "hintIcon": "Leave blank to auto-generate",
                            "columnSpan": 1,
                            "required": false,
                            "validation": [
                                "regex:/^[a-zA-Z_][a-zA-Z0-9_]*$/"
                            ]
                        },
                        {
                            "component": "select",
                            "name": "foreign_key",
                            "label": "Foreign Key",
                            "columnSpan": 1,
                            "options_source": "helper",
                            "helper_type": "dynamic",
                            "helper_class": "App\\Helpers\\CommonHelper",
                            "helper_method": "getForeignKeyOptions",
                            "helper_params": [
                                "related_module",
                                "type",
                                "../../name"
                            ],
                            "required": false,
                            "searchable": true,
                            "placeholder": "Auto (use Laravel default)",
                            "hintIcon": "hasOne/hasMany → field on related table · belongsTo → field on this table"
                        }
                    ]
                }
            ]
        }
    ]
}