{
    "title": "Modules",
    "model": "App\\Models\\Module",
    "perPage": 15,
    "defaultSort": {
        "column": "created_at",
        "direction": "desc"
    },
    "columns": [
        {
            "type": "text",
            "name": "plural_label",
            "label": "Module",
            "sortable": true,
            "sortable_field": ["key", "plural_label"],
            "searchable": { "individual": true },
            "searchable_fields": ["key", "plural_label", "name"],
            "description": "description",
            "wrap": false
        },
        {
            "type": "text",
            "name": "key",
            "label": "Key",
            "sortable": true,
            "badge": true,
            "default": "—"
        },
        {
            "type": "text",
            "name": "singular_label",
            "label": "Singular Label",
            "sortable": true,
            "default": "—"
        },
        {
            "type": "text",
            "name": "plural_label",
            "label": "Plural Label",
            "sortable": true,
            "default": "—"
        },
        {
            "type": "icon",
            "name": "is_deploy",
            "label": "Deployed",
            "boolean": true,
            "sortable": true
        },
        {
            "type": "icon",
            "name": "is_enable",
            "label": "Active",
            "boolean": true,
            "sortable": true
        },
        {
            "type": "text",
            "name": "deployed_at",
            "label": "Deployed At",
            "date": true,
            "format": "d M Y",
            "sortable": true,
            "default": "—"
        },
        {
            "type": "text",
            "name": "createdBy.name",
            "label": "Created By",
            "sortable": false,
            "default": "—",
            "toggleable": true,
            "toggledHiddenByDefault": true
        },
        {
            "type": "text",
            "name": "created_at",
            "label": "Created At",
            "date": true,
            "format": "d M Y, h:i A",
            "sortable": true,
            "default": "—",
            "toggleable": true,
            "toggledHiddenByDefault": true
        },
        {
            "type": "text",
            "name": "updatedBy.name",
            "label": "Updated By",
            "sortable": false,
            "default": "—",
            "toggleable": true,
            "toggledHiddenByDefault": true
        },
        {
            "type": "text",
            "name": "updated_at",
            "label": "Updated At",
            "date": true,
            "format": "d M Y, h:i A",
            "sortable": true,
            "default": "—",
            "toggleable": true,
            "toggledHiddenByDefault": true
        }
    ],
    "filters": [
        {
            "type": "select",
            "name": "is_deploy",
            "label": "Deployment Status",
            "options": {
                "1": "Deployed",
                "0": "Not Deployed"
            }
        },
        {
            "type": "select",
            "name": "is_enable",
            "label": "Active Status",
            "options": {
                "1": "Active",
                "0": "Inactive"
            }
        },
        {
            "type": "select",
            "name": "key",
            "label": "Key",
            "options_source": "helper",
            "helper_class": "App\\Filament\\Resources\\Modules\\Hooks\\ModuleHooks",
            "helper_method": "getKeyOptions",
            "helper_params": []
        }
    ],
    "filters_layout": "modal",
    "record_action": null,
    "record_url": null,
    "actions": [
        {
            "type": "view",
            "label": "Details",
            "ui": {
                "hiddenLabel": true,
                "iconButton": true,
                "tooltip": "View Details",
                "icon": "heroicon-o-eye"
            }
        },
        {
            "type": "edit",
            "label": "Edit",
            "ui": {
                "icon": "heroicon-m-pencil-square",
                "slideOver": true,
                "hiddenLabel": true,
                "iconButton": true,
                "tooltip": "Edit Module",
                "modalHeading": "Update Module",
                "modalWidth": "7xl"
            }
        },
        {
            "type": "group",
            "label": "More",
            "icon": "heroicon-o-ellipsis-horizontal",
            "items": [
                {
                    "type": "custom",
                    "name": "toggle_module",
                    "label": "Enable / Disable",
                    "hidden_when": {
                        "field": "is_deploy",
                        "value": false
                    },
                    "ui": {
                        "icon": "heroicon-o-power",
                        "color": "warning",
                        "modalHeading": "Change Module Status",
                        "modalDescription": "Are you sure you want to change the status of this module?",
                        "modalSubmitActionLabel": "Confirm",
                        "modalWidth": "md"
                    },
                    "hooks": {
                        "action": "\\App\\Filament\\Resources\\Modules\\Hooks\\ModuleHooks@toggleModule"
                    }
                },
                {
                    "type": "custom",
                    "name": "deploy_module",
                    "label": "Deploy",
                    "hidden_when": {
                        "field": "is_deploy",
                        "value": true
                    },
                    "ui": {
                        "icon": "heroicon-o-cloud-arrow-up",
                        "color": "success",
                        "modalHeading": "Deploy Module",
                        "modalDescription": "This will generate all required files, database migrations, models, resources, and layouts for this module. Do you want to continue?",
                        "modalSubmitActionLabel": "Yes, Deploy",
                        "modalWidth": "md"
                    },
                    "hooks": {
                        "action": "\\App\\Filament\\Resources\\Modules\\Hooks\\ModuleHooks@deployModule"
                    }
                },
                {
                    "type": "custom",
                    "name": "uninstall",
                    "label": "Uninstall",
                    "hidden_when": {
                        "field": "is_deploy",
                        "value": false
                    },
                    "ui": {
                        "icon": "heroicon-o-trash",
                        "color": "danger",
                        "modalHeading": "Uninstall Module",
                        "modalDescription": "This action will remove all generated files, resources, and configurations for this module. You can optionally remove the database table as well. This action cannot be undone.",
                        "modalSubmitActionLabel": "Yes, Uninstall",
                        "modalWidth": "xl"
                    },
                    "form": {
                        "components": [
                            {
                                "component": "grid",
                                "columnSpan": "full",
                                "columns": 2,
                                "schema": [
                                    {
                                        "component": "toggle",
                                        "name": "is_table",
                                        "label": "Also drop the database table?",
                                        "columnSpan": 1
                                    },
                                    {
                                        "component": "toggle",
                                        "name": "is_custom",
                                        "label": "Also drop the custom directory?",
                                        "columnSpan": 1,
                                        "validate_on_blur": true,
                                        "custom_after_state_updated": "\\App\\Filament\\Resources\\Modules\\Hooks\\ModuleHooks@uninstallwarning",
                                        "custom_after_state_updated_related": [
                                            "custom_dummy"
                                        ]
                                    },
                                    {
                                        "component": "view",
                                        "name": "custom_dummy",
                                        "view": "filament.components.custom-dummy",
                                        "columnSpan": "full"
                                    }
                                ]
                            }
                        ]
                    },
                    "hooks": {
                        "action": "\\App\\Filament\\Resources\\Modules\\Hooks\\ModuleHooks@uninstall"
                    }
                },
                {
                    "type": "custom",
                    "name": "repair_rebuild",
                    "label": "Repair & Rebuild",
                    "hidden_when": {
                        "field": "is_deploy",
                        "value": false
                    },
                    "ui": {
                        "icon": "heroicon-o-arrow-path",
                        "color": "warning",
                        "modalHeading": "Repair & Rebuild Module",
                        "modalDescription": "This will repair and rebuild the module by regenerating missing files and ensuring the database schema and layouts are up to date. Do you want to continue?",
                        "modalSubmitActionLabel": "Yes, Repair & Rebuild",
                        "modalWidth": "md"
                    },
                    "hooks": {
                        "action": "\\App\\Filament\\Resources\\Modules\\Hooks\\ModuleHooks@repairRebuild"
                    }
                },
                {
                    "type": "custom",
                    "name": "clone_module",
                    "label": "Clone",
                    "ui": {
                        "icon": "heroicon-o-document-duplicate",
                        "color": "info",
                        "modalHeading": "Clone Module",
                        "modalSubmitActionLabel": "Clone",
                        "modalWidth": "md"
                    },
                    "form": {
                        "components": [
                            {
                                "component": "grid",
                                "columns": 1,
                                "schema": [
                                    {
                                        "component": "textInput",
                                        "name": "name",
                                        "label": "New Module Name",
                                        "placeholder": "e.g. lead_copy",
                                        "hint": "Lowercase letters, numbers and underscores only",
                                        "required": true,
                                        "validation": [
                                            "max:50",
                                            "regex:/^[a-z][a-z0-9_]*$/"
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    "hooks": {
                        "action": "\\App\\Filament\\Resources\\Modules\\Hooks\\ModuleHooks@cloneModule"
                    }
                },
                {
                    "type": "delete",
                    "name": "delete",
                    "label": "Delete",
                    "hidden_when": {
                        "field": "is_deploy",
                        "value": true
                    }
                }
            ]
        }
    ],
    "record_actions_position": "BeforeColumns",
    "bulkActions": []
}