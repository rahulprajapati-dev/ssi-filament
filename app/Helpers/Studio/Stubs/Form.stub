<?php

namespace App\Filament\Resources\{{RESOURCE}}\Schemas;

use App\Helpers\JsonStudioFormBuilder;
use Filament\Schemas\Schema;
use Illuminate\Support\Facades\File;

class {{MODEL}}Form
{
    public static function configure(Schema $schema): Schema
    {
        $operation = $schema->getOperation();

        $configFile = match ($operation) {
            'create' => 'createView.json',
            'edit'   => 'editView.json',
            'view'   => 'detailView.json',
            default  => 'default.json',
        };    

        $configPath = base_path("app/Filament/Resources/{{RESOURCE}}/Schemas/{$configFile}");
        $Custom = base_path("app/Filament/Resources/{{RESOURCE}}/CustomSchemas/{$configFile}");

        if(File::exists($Custom))
        {
            $configPath = $Custom;
        }
        
        if (! File::exists($configPath)) {
            return $schema->components([]);
        }

        $config = json_decode(File::get($configPath), true) ?? [];

        if (json_last_error() !== JSON_ERROR_NONE) {
            \Illuminate\Support\Facades\Log::error('Form: invalid JSON in schema file', [
                'path'  => $configPath,
                'error' => json_last_error_msg(),
            ]);
            return $schema->components([]);
        }

        return JsonStudioFormBuilder::buildSchema($schema, $config);
    }
}
