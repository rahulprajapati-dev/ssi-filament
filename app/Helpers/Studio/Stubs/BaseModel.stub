use App\Traits\ModuleHookTrait;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Support\Str;

/**
 * Studio-managed base for {{MODEL}}.
 * Regenerated on every Repair & Rebuild — do not edit this file.
 * Add custom scopes, accessors, and methods in App\Models\{{MODEL}} instead.
 */
abstract class Base{{MODEL}} extends Model
{
    use HasCreatedBy;
    use ModuleHookTrait;

    protected $table = '{{TABLE}}';

    protected $guarded = ['id'];

    protected $casts = [
        'created_at' => 'datetime',
        'updated_at' => 'datetime',
{{FIELD_CASTS}}    ];

    protected static function boot(): void
    {
        parent::boot();
        static::creating(function ($model) {
            if (empty($model->uuid)) {
                $model->uuid = (string) Str::uuid();
            }
        });
    }

