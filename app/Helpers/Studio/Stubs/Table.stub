<?php

namespace App\Filament\Resources\{{RESOURCE}}\Tables;

use App\Helpers\JsonTableBuilder;
use Filament\Tables\Table;
use Illuminate\Support\Facades\File;

class {{RESOURCE}}Table
{
    public static function configure(Table $table): Table
    {
        $configPath = base_path('app/Filament/Resources/{{RESOURCE}}/Tables/listView.json');

        $Custom = base_path("app/Filament/Resources/{{RESOURCE}}/CustomTables/listView.json");

        if(File::exists($Custom))
        {
            $configPath = $Custom;
        }

        $config = [];
        if (File::exists($configPath)) {
            $raw    = json_decode(File::get($configPath), true);
            if (json_last_error() !== JSON_ERROR_NONE) {
                \Illuminate\Support\Facades\Log::error('Studio Table: invalid JSON config', [
                    'path'  => $configPath,
                    'error' => json_last_error_msg(),
                ]);
            } else {
                $config = $raw ?? [];
            }
        }

        return JsonTableBuilder::build($table, $config);
    }
}
